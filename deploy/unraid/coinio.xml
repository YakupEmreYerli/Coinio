<?xml version="1.0"?>
<Container version="2">
  <Name>Coinio</Name>
  <Repository>ghcr.io/yakupemreyerli/coinio:latest</Repository>
  <Registry>https://github.com/YakupEmreYerli/coinio/pkgs/container/coinio</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/YakupEmreYerli/coinio/issues</Support>
  <Project>https://github.com/YakupEmreYerli/coinio</Project>
  <Overview>Self-hosted subscription and bill tracker: calm dashboard, Telegram reminders, MCP server for AI assistants and an iPhone widget.</Overview>
  <Category>Tools: Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/YakupEmreYerli/coinio/main/public/icon-512.png</Icon>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="Web interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/coinio" Mode="rw" Description="Database and logos" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/coinio</Config>
  <Config Name="Public URL" Target="COINIO_PUBLIC_URL" Default="" Mode="" Description="Your https address, e.g. https://subs.example.com (needed for claude.ai connectors; leave empty if you only use it at home)" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Time zone" Target="TZ" Default="UTC" Mode="" Description="Container time zone; set it to your own, e.g. Europe/Berlin" Type="Variable" Display="always" Required="false" Mask="false">UTC</Config>
</Container>
