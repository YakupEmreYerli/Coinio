# Copy to .env and adjust. Everything else is set in the app (Settings).

# The address you open the app at. Needed for claude.ai / Claude mobile connectors (OAuth).
COINIO_PUBLIC_URL=https://subs.example.com

# Container time zone (log timestamps); set it to your own, e.g. Europe/Berlin. The zone that
# "today", automatic payments and reminders follow is chosen in the app (Settings › General).
TZ=UTC

# Optional: Telegram reminders can also be set here instead of in Settings.
# COINIO_TELEGRAM_BOT_TOKEN=
# COINIO_TELEGRAM_CHAT_ID=
